> {%
  if (response.status === 201) {
      const ACCESS_TOKEN = response.body.data.accessToken;
      const REFRESH_TOKEN = response.headers
          .all()
          ['Set-Cookie'].value[0].match(/refreshToken=([^;]+)/)[1];
  
      client.global.set('ACCESS_TOKEN', ACCESS_TOKEN);
      client.global.set('REFRESH_TOKEN', REFRESH_TOKEN);
  }
%}


